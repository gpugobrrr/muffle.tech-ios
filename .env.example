# Copy this file to .env.local, provide the key, then fully reload Expo.
# Never commit the real key.
EXPO_PUBLIC_LOQATE_API_KEY=
# Restrict this browser-visible key to the Maps Static, Street View Static,
# Street View Static Metadata, and Geocoding APIs plus this app's origins.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional — enables cloud speech-to-text via OpenAI Whisper.
EXPO_PUBLIC_OPENAI_API_KEY=
