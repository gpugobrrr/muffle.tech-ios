{
  "expo": {
    "name": "Muffle Demo",
    "slug": "muffle-demo",
    "version": "1.0.0",
    "assetBundlePatterns": ["assets/images/*", "assets/models/*"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muffledemo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Muffle to record voice macros during inspection.",
        "NSCameraUsageDescription": "Allow Muffle to capture inspection photos.",
        "NSPhotoLibraryUsageDescription": "Allow Muffle to attach inspection photos from your library."
      }
    },
    "android": {
      "screenOrientation": "portrait",
      "permissions": ["RECORD_AUDIO", "CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#F1F1ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F1ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
